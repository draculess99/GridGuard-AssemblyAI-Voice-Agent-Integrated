# GridGuard Configuration

# Data Mode: "synthetic", "kaggle_historical", or "eia_live"
GRIDGUARD_DATA_MODE=synthetic

# External API Keys (Leave blank if using internal expert system)
GROQ_API_KEY=
GEMINI_API_KEY=

# Decision engine: "internal_expert_system", "groq", or "gemini"
GRIDGUARD_DECISION_PROVIDER=groq

# EIA Configuration
EIA_API_KEY=
GRIDGUARD_EIA_RESPONDENT=ISNE

# CALL-E Configuration (Mocked by default)
# To use real CALL-E, refer to the CALL-E setup instructions in README.md
CALLE_API_KEY=
CALLE_AUTHORIZED_TEST_NUMBER=

# AssemblyAI (Assembly Voice tab). Leave blank for safe Mock Mode.
ASSEMBLYAI_API_KEY=
